# data and state
.luminary/
*.db
*.db-shm
*.db-wal

# secrets -- COPY backend/ . had no guard against this and baked a real
# OPENAI_API_KEY from a developer's backend/.env straight into an image layer.
# Compose passes what the container needs through `environment:`; nothing
# reads a .env file from inside the image.
.env
**/.env
**/.env.*

# deps and build artefacts
frontend/node_modules/
frontend/dist/
backend/.venv/
backend/__pycache__/
**/__pycache__/
**/*.pyc

# dev tooling
.git/
.github/
.claude/
scripts/ralph/
scripts/corpus/
evals/
DATA/

# docs
docs/
*.md
!README.md

# test artefacts
backend/tests/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
