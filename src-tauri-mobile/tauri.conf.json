{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luminary",
  "version": "0.1.0",
  "identifier": "sh.luminary.mobile",
  "build": {
    "frontendDist": "../frontend/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luminary"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.png"
    ]
  }
}
