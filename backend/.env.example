# Luminary configuration.
#
# The macOS installer renders this file into <prefix>/backend/.env and fills the
# @@PLACEHOLDER@@ values. Copy it to .env by hand for a source checkout.
#
# NOTE: this file is read relative to the process working directory, so the
# server must be started from the directory that contains it.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Absolute path to the library: SQLite, LanceDB, Kuzu, and downloaded model
# weights. MUST live outside the app directory -- an upgrade replaces that
# directory wholesale.
DATA_DIR=@@DATA_DIR@@

# public: curated learner surfaces, SPA + API on one port under /api.
# full:   every surface, routers at root, CORS open for the Vite dev server.
LUMINARY_MODE=@@LUMINARY_MODE@@

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MODELS -- this is the one file to edit
# ---------------------------------------------------------------------------
# Which model does what is decided in exactly one module
# (`app/model_registry.py`), and it reads the four knobs below. No service
# reads a model name out of config on its own; `tests/test_model_registry.py`
# fails if one starts to.
#
# Precedence, strongest first:
#   1. Settings in the app  -- what you pick in the UI, stored in the database.
#                              Per-machine, survives an .env change, and wins.
#   2. These variables      -- the deployment default for this install.
#   3. The registry default -- host-aware: below 16GB one model fills every
#                              role, above 24GB a larger text model is used.
#                              Only applies where 1 and 2 say nothing.
#
# An id is `provider/name`. Anything Ollama holds works (`ollama list`), and so
# does a hosted model if you supply its key: `openai/gpt-4o-mini`,
# `anthropic/claude-...`, `gemini/...`. Keys go in the API-KEYS section below or
# in Settings; a local id needs no key.
#
# A model larger than this machine is a warning, never a refusal -- the app
# reports it at `GET /settings/models` and in the Settings screen rather than
# overruling you. `make models` prints what the current configuration costs.

OLLAMA_URL=http://127.0.0.1:11434

# Chat, and the fallback for every other role. Leave unset to let the registry
# size it from installed RAM.
LITELLM_DEFAULT_MODEL=ollama/qwen3.5:4b

# Flashcards, summaries and other generated artefacts. Empty = follow the model
# above (and the Settings choice with it). Set this only to send generation
# somewhere else -- a bigger local model, or a hosted one.
# LITELLM_GENERATION_MODEL=

# Image and figure analysis. Must be a model with vision; `ollama show <model>`
# lists its capabilities. Empty = the registry picks one that fits, which on a
# single-model machine is the chat model itself.
#   ollama pull <model>    # required before first use
VISION_MODEL=ollama/qwen3.5:4b

# Checks that a generated flashcard's answer follows from its passage, and drops
# the card when it does not. Off by default and deliberately without a fallback:
# measured on 59 cards, phi4-mini passed 54 and granite3.2:8b 53, agreeing with
# a 14B on the pass/fail call ~0.41 -- a gate on either certifies what it was
# added to catch. Must not be the generation model (a model grading its own work
# agrees with itself); the app refuses to run it if it is.
# FLASHCARD_FACTUALITY_MODEL=ollama/gemma4:latest

# Max concurrent vision calls. Set by the install profile:
# public=1 (under 16GB), standard=2 (16-24GB), performance=4 (over 24GB).
ENRICHMENT_VISION_CONCURRENCY=@@VISION_CONCURRENCY@@

# How many requests Ollama serves at once; also caps enrichment concurrency.
# One KV cache per slot, so 1 under 16GB and 2 above. The desktop app reads this
# from the .env in your library directory and passes it to the Ollama it starts.
OLLAMA_NUM_PARALLEL=@@OLLAMA_NUM_PARALLEL@@

# Overrides the RAM-sized profile: low | standard | performance. The installer
# writes it; set it by hand to force a smaller footprint on a large machine.
# LUMINARY_MEMORY_PROFILE=

# Rasterize vector-drawn PDF figures when a page embeds no raster image.
# Papers whose figures are drawn with path operators extract zero images
# without it. Each recovered figure costs one vision call.
# PDF_VECTOR_FIGURES=true

# Disable on memory-constrained machines to avoid OOM during ingestion.
GLINER_ENABLED=true

# ---------------------------------------------------------------------------
# Optional cloud providers -- leave blank to stay fully local.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Tracing -- off by default; Phoenix runs a local server on :6006.
# ---------------------------------------------------------------------------
PHOENIX_ENABLED=false

# ---------------------------------------------------------------------------
# Blog publishing (full mode) -- publish a note as a post in your own site repo.
# Unset means the feature is off: the Blog & Thoughts panel reports it and every
# write endpoint refuses. Point REPO_PATH at a local git clone of your site.
# ---------------------------------------------------------------------------
# LUMINARY_BLOG_REPO_PATH=~/dev/my-site
# LUMINARY_BLOG_URL_BASE=https://example.github.io
# LUMINARY_BLOG_CONTENT_SUBDIR=src/content/blog
# LUMINARY_BLOG_ASSET_SUBDIR=public/blog
# LUMINARY_BLOG_BRANCH=master
